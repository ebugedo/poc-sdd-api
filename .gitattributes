###############################################################################
# CONFIGURACIÓN GLOBAL DE FINALES DE LÍNEA (Windows 11 / OpenCode / IA)
###############################################################################
# Trata todos los archivos de texto automáticamente y fuerza LF en el checkout
* text=auto eol=lf

###############################################################################
# ARCHIVOS DE TEXTO Y CÓDIGO FUENTE (Fuerza eol=lf explícito)
###############################################################################
# TypeScript / JavaScript / Node.js
*.js                    text eol=lf
*.jsx                   text eol=lf
*.ts                    text eol=lf
*.tsx                   text eol=lf
*.json                  text eol=lf
*.json5                 text eol=lf

# Web Frameworks & Markup
*.html                  text eol=lf
*.css                   text eol=lf
*.scss                  text eol=lf
*.sass                  text eol=lf
*.less                  text eol=lf
*.vue                   text eol=lf
*.svelte                text eol=lf
*.graphql               text eol=lf

# Backend (Python, Java, Go, C#, PHP, Ruby, Rust)
*.py                    text eol=lf
*.java                  text eol=lf
*.go                    text eol=lf
*.cs                    text eol=lf
*.php                   text eol=lf
*.rb                    text eol=lf
*.rs                    text eol=lf
*.c                     text eol=lf
*.cpp                   text eol=lf
*.h                     text eol=lf
*.hpp                   text eol=lf

# Configuración, Documentación e IA
*.md                    text eol=lf
*.markdown              text eol=lf
*.txt                   text eol=lf
*.yml                   text eol=lf
*.yaml                  text eol=lf
*.toml                  text eol=lf
*.env*                  text eol=lf
.gitignore              text eol=lf
.gitattributes          text eol=lf
.editorconfig           text eol=lf
LICENSE                 text eol=lf

###############################################################################
# SCRIPTS ESPECÍFICOS DE SISTEMA OPERATIVO
###############################################################################
# Scripts de Shell / Linux / Docker (DEBEN usar siempre LF)
*.sh                    text eol=lf
Dockerfile              text eol=lf

# Scripts nativos de Windows (Mantienen CRLF obligatoriamente para ejecutarse)
*.bat                   text eol=crlf
*.cmd                   text eol=crlf
*.ps1                   text eol=crlf

###############################################################################
# RECURSOS BINARIOS (Sin tratamiento de finales de línea)
###############################################################################
# Imágenes y Gráficos
*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.gif                   binary
*.webp                  binary
*.ico                   binary
*.svg                   text eol=lf
*.pdf                   binary

# Fuentes
*.woff                  binary
*.woff2                 binary
*.ttf                   binary
*.eot                   binary
*.otf                   binary

# Compilados y Paquetes
*.exe                   binary
*.dll                   binary
*.so                    binary
*.dylib                 binary
*.zip                   binary
*.tar.gz                binary
*.7z                    binary
*.jar                   binary