{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git status *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git push * main": "deny",
      "git push origin main": "deny",
      "git push *": "ask",
      "git pull *": "ask",
      "git fetch *": "ask",
      "git remote *": "ask"
    }
  }
}